+        const int64_t blocks_key = gguf_find_key(ctx.get(), (arch + ".block_count").c_str());
+        if (blocks_key < 0) return {};
+        const uint32_t blocks = gguf_get_val_u32(ctx.get(), blocks_key);
+        return gguf_find_tensor(ctx.get(), ("blk." + std::to_string(blocks - 1) + ".nextn.eh_proj.weight").c_str()) >= 0
