+    llama_model_params parent = *mparams_parent;
+    parent.no_alloc  = true;
+    parent.load_mode = LLAMA_LOAD_MODE_NONE;
+    llama_model * model_parent = llama_model_load_from_file(path_parent, parent);
+    if (!model_parent) {
+        throw std::runtime_error("failed to load parent model");
+    }
+    llama_context * ctx_parent = llama_init_from_model(model_parent, *cparams_parent);
+    if (!ctx_parent) {
+        llama_model_free(model_parent);
+        throw std::runtime_error("failed to create parent llama_context");
+    }
+    // The current memory probe does not accept a parent context. Keep the parent
+    // alive while measuring so backend allocation and device placement match it.
+    const auto result = common_get_device_memory_data(path_model, mparams, cparams, devs,
+            hp_ngl, hp_n_ctx_train, hp_n_expert, log_level);
+    llama_free(ctx_parent);
+    llama_model_free(model_parent);
+    return result;
+}
